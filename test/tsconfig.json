{
  "compilerOptions": {
    "target": "ES2023",
    "module": "preserve",
    "types": ["node"],
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/test-temp-*"]
}
