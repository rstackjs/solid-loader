{
  "name": "solid-loader",
  "version": "0.1.1",
  "description": "Solid JSX and refresh loaders for Rspack",
  "repository": "https://github.com/rstackjs/solid-loader",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./refresh": {
      "types": "./dist/refresh.d.ts",
      "default": "./dist/refresh.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rs lib",
    "bump": "pnpm version -m \"release: v%s\"",
    "check": "rs check",
    "dev": "rs lib -w",
    "format": "rs fmt",
    "lint": "rs lint",
    "prepare": "rs hooks",
    "test": "rs test"
  },
  "dependencies": {
    "@babel/core": "^7.29.13",
    "@jridgewell/remapping": "^2.3.5",
    "@solidjs/babel-plugin": "^2.0.0",
    "@solidjs/compiler": "^2.0.0"
  },
  "devDependencies": {
    "@rspack/core": "catalog:",
    "@rspack/dev-server": "catalog:",
    "@rstackjs/test-utils": "^1.0.0",
    "@rstest/playwright": "^0.12.6",
    "@solidjs/web": "catalog:",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.19.2",
    "playwright": "^1.65.0",
    "rstack": "^0.9.1",
    "solid-js": "catalog:",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@rspack/core": "^2.0.0",
    "@solidjs/web": "^2.0.0",
    "solid-js": "^2.0.0"
  },
  "packageManager": "pnpm@12.18.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
